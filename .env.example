# ─── Supabase ────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com, then copy these from
# Project Settings → API. Leave them blank to run OPERATOR FORGE in Simulator
# Mode (a local, cookie-backed operator identity — see README).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Required for Messages and the AI Assistant. Without it the rest of the shift
# still runs; the chat panels say plainly that they are not connected.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=

# ─── App ─────────────────────────────────────────────────────────────────────
# Absolute origin used to build OAuth / magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. A video shown between the handover message and the countdown.
# Defaults to /handover.mp4 — drop a file in public/ and it is picked up.
NEXT_PUBLIC_HANDOVER_VIDEO_URL=

# ─── QA only ─────────────────────────────────────────────────────────────────
# Speeds the mission clock so the full 60-minute arc can be exercised.
# `12` runs the hour in five minutes. Ignored in production builds.
NEXT_PUBLIC_MISSION_TIME_SCALE=
